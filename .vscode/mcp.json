{
	"servers": {
		"supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp"
		},
		"anima": {
			"type": "http",
			"url": "https://public-api.animaapp.com/v1/mcp"
		},
		"awesome-copilot": {
			"command": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe",
			"args": [
				"run",
				"--rm",
				"-i",
				"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:1.0.2026070300"
			],
			"type": "stdio"
		},
		"cap-js": {
			"command": "C:\\Program Files\\nodejs\\npx.cmd",
			"args": [
				"-y",
				"@cap-js/mcp-server"
			],
			"type": "stdio"
		},
		"shipstatic": {
			"type": "http",
			"url": "https://mcp.shipstatic.com"
		},
		"io.github.AnimaApp/anima": {
			"type": "http",
			"url": "https://public-api.animaapp.com/v1/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"io.github.microsoft/awesome-copilot": {
			"type": "stdio",
			"command": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe",
			"args": [
				"run",
				"-i",
				"--rm",
				"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:1.0.2026070300"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.2026070300"
		},
		"com.shipstatic/mcp": {
			"type": "stdio",
			"command": "C:\\Program Files\\nodejs\\npx.cmd",
			"args": [
				"@shipstatic/mcp@0.6.0"
			],
			"env": {
				"SHIP_API_KEY": "${input:SHIP_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "0.6.0"
		}
	},
	"inputs": [
		{
			"id": "SHIP_API_KEY",
			"type": "promptString",
			"description": "Optional. Without it, deploys behave like the hosted endpoint (public, claim URL, 3-day expiry). With it, deployments are permanent, the full toolset (custom domains, listing, account-tied ops) unlocks, and you get bigger limits.",
			"password": true
		}
	]
}