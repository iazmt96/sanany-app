NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-web-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-web-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-mobile-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-mobile-anon-key
