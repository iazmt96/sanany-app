    "@sanany/ui": "file:../../packages/ui",
    "@sanany/utils": "file:../../packages/utils",
    "expo": "~54.0.36",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^24.0.0",
